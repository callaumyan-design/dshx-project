{
  "name": "dshx-project",
  "version": "2.1.0",
  "description": "Open the session's real project in the file manager from the session header. The project is the user's pick, the model's set_project record, or inferred from the session log's tool calls.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "author": "callaumyan-design",
  "license": "MIT",
  "homepage": "https://github.com/callaumyan-design/dshx-project#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callaumyan-design/dshx-project.git"
  },
  "bugs": {
    "url": "https://github.com/callaumyan-design/dshx-project/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "infer.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "marketplace": {
      "profiles": [
        "web",
        "desktop"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  }
}
